{
  "name": "t3-code-agent-mcp",
  "version": "0.1.0",
  "description": "Local MCP server (stdio) that lets coding agents start and drive T3 Code threads through the running T3 server.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "t3-code-agent-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ws": "^8.21.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gfsaaser24/t3-code-agent-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "t3-code",
    "coding-agents",
    "claude-code",
    "codex",
    "cursor"
  ]
}
